```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Dependencies
venv/
.venv/
.env
.env.local
*.env.*

# Logs
*.log

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Build artifacts
dist/
build/
target/

# Coverage reports
coverage/
htmlcov/
.coverage

# Testing
.pytest_cache/
.mypy_cache/
```